# Copy to .env and fill in. `make run` passes these to the app container.
# Any OpenAI-compatible Apertus 1.5 endpoint works:
#   Public AI gateway (Swiss-hosted Apertus): https://api.publicai.co/v1  model swiss-ai/apertus-v1.5-8b
#   CSCS hackathon endpoint: the base URL and model name from your CSCS key
LLM_BASE_URL=https://api.publicai.co/v1
LLM_API_KEY=
LLM_NAME=swiss-ai/apertus-v1.5-8b
